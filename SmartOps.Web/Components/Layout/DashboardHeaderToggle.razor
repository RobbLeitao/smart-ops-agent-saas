@* Small interactive island (mirrors NotificationBell/TransactionDetailDrawer's pattern of
   an InteractiveServer component embedded inside the otherwise static MainLayout) that
   surfaces the Dashboard's "Pausar/Reanudar notificaciones" action in the shared header.
   Hidden on any page where Dashboard hasn't registered itself (e.g. Historial, Integraciones). *@
@using SmartOps.Web.Services
@inject DashboardHeaderActionsService HeaderActions
@implements IDisposable

@if (HeaderActions.IsRegistered)
{
    <span class="live-status @(HeaderActions.IsPaused ? "is-paused" : "")" role="status">
        <span class="live-dot" aria-hidden="true"></span>@(HeaderActions.IsPaused ? "Pausado" : "En vivo")
    </span>
    <button type="button" class="live-toggle" aria-label="@(HeaderActions.IsPaused ? "Reanudar notificaciones" : "Pausar notificaciones")" @onclick="Toggle">
        @(HeaderActions.IsPaused ? "Reanudar" : "Pausar")
    </button>
}

@code {
    protected override void OnInitialized()
    {
        HeaderActions.OnChange += HandleChange;
    }

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task Toggle()
    {
        await HeaderActions.ToggleAsync();
    }

    public void Dispose()
    {
        HeaderActions.OnChange -= HandleChange;
    }
}
