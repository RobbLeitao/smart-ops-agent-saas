@using SmartOps.Infrastructure.Data
@using SmartOps.Core.Entities
@inject AppDbContext Db
@inject NavigationManager NavigationManager
@inject SmartOps.Web.Services.TransactionDrawerService DrawerService
@inject Microsoft.Extensions.Logging.ILogger<NotificationBell> Logger
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.EntityFrameworkCore
@using SmartOps.Web.Services
@implements IAsyncDisposable

@* Campana y desplegable de notificaciones (docs/redesign/07-notificaciones.html). *@
<div class="notif">
    @if (open)
    {
        <!-- Backdrop transparente: el click afuera cierra el desplegable, como el del Drawer. -->
        <div class="notif-backdrop" @onclick="CloseAndFocusBell"></div>
    }

    <button id="notification-bell-btn" type="button" class="notif-bell @(open ? "is-open" : null)" @ref="bellRef"
            aria-label="@NotificationFormat.AriaLabel(UnreadCount)" aria-expanded="@(open ? "true" : "false")"
            aria-controls="notification-panel" aria-haspopup="true" @onclick="Toggle">
        <i class="bi bi-bell" aria-hidden="true"></i>
        @if (NotificationFormat.Badge(UnreadCount) is { } badge)
        {
            <span class="notif-badge" aria-hidden="true">@badge</span>
        }
    </button>

    @if (open)
    {
        <section id="notification-panel" class="notif-panel" aria-label="Notificaciones" tabindex="-1"
                 @ref="panelRef" @onkeydown="HandleKeyDown">
            <div class="notif-head">
                <div class="notif-head-text">
                    <h2 class="notif-title">Notificaciones</h2>
                    <span class="notif-count">@UnreadCount sin leer</span>
                </div>
                <button type="button" class="notif-mark-all" disabled="@(UnreadCount == 0)" @onclick="MarkAllRead">Marcar todas como leídas</button>
            </div>

            @if (notifications.Count == 0)
            {
                <p class="notif-empty">No hay notificaciones.</p>
            }
            else
            {
                <ul class="notif-list">
                    @foreach (var n in notifications)
                    {
                        <li class="notif-item @(n.IsRead ? "is-read" : "is-unread")" data-id="@n.Id">
                            @if (n.IsRead)
                            {
                                <span class="notif-dot notif-dot-read" aria-hidden="true"></span>
                            }
                            else
                            {
                                <span class="notif-dot dot-danger" aria-hidden="true"></span>
                                <span class="visually-hidden">Sin leer.</span>
                            }
                            <div class="notif-body">
                                <div class="notif-row">
                                    <span class="notif-item-title">
                                        @if (n.TransactionId.HasValue)
                                        {
                                            <span>Falló la <span class="mono">TX @n.TransactionId</span></span>
                                        }
                                        else
                                        {
                                            <span>@n.Title</span>
                                        }
                                    </span>
                                    <span class="notif-ago">@NotificationFormat.RelativeTime(n.CreatedAt, DateTime.UtcNow)</span>
                                </div>
                                <span class="notif-meta">@HistoryFormat.Reason(n.Message) · <span class="mono">@HistoryFormat.Card(GetLast4(n.TransactionId))</span></span>
                                <div class="notif-actions">
                                    @if (n.TransactionId.HasValue)
                                    {
                                        <button type="button" class="notif-analyze" @onclick="() => Analyze(n.TransactionId, n.Id)">Analizar</button>
                                    }
                                    @if (!n.IsRead)
                                    {
                                        <button type="button" class="notif-mark-read" @onclick="() => MarkAsRead(n.Id)">Marcar leída</button>
                                    }
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            }
        </section>
    }
</div>

@code {
    private List<Notification> notifications = new();
    private Dictionary<int, string> cardLast4Cache = new();
    private int UnreadCount = 0;
    private bool open = false;
    private bool _shouldFocusPanel;
    private ElementReference panelRef;
    private ElementReference bellRef;
    private bool _shouldFocusBell;
    private HubConnection? hubConnection;
    private readonly SemaphoreSlim _refreshLock = new(1,1);

    protected override async Task OnInitializedAsync()
    {
        // Only load data here — hub setup must happen in OnAfterRenderAsync(firstRender)
        // because OnInitializedAsync runs during SSR pre-render where there is no
        // RendererSynchronizationContext; calling InvokeAsync from a SignalR handler
        // during pre-render throws InvalidCastException and corrupts the circuit.
        await LoadNotificationsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // El Drawer de Detalle va por encima de todo: cuando se abre, el desplegable se cierra.
            DrawerService.Register(OnDrawerChanged);
            _drawerRegistered = true;

            // Safe to start SignalR here — OnAfterRenderAsync only runs in interactive mode,
            // never during SSR pre-render.
            hubConnection = new HubConnectionBuilder()
                .WithUrl(NavigationManager.ToAbsoluteUri("/hubs/transactions"))
                .WithAutomaticReconnect()
                .Build();

            hubConnection.On<int>("ReceiveTransaction", async (_) =>
            {
                try { await InvokeAsync(SafeRefreshAsync); } catch { }
            });

            hubConnection.On<int>("NotificationCreated", async (_) =>
            {
                try { await InvokeAsync(SafeRefreshAsync); } catch { }
            });

            hubConnection.Reconnecting += _ => { Logger.LogWarning("NotificationBell SignalR reconnecting"); return Task.CompletedTask; };
            hubConnection.Closed += _ => { Logger.LogWarning("NotificationBell SignalR closed"); return Task.CompletedTask; };

            try { await hubConnection.StartAsync(); }
            catch (Exception ex) { Logger.LogWarning(ex, "Failed to start hub in NotificationBell"); }
        }

        // Focus the panel right after it opens so keydown (Escape) events are captured,
        // mirroring how TransactionDetailDrawer focuses itself on open.
        if (_shouldFocusBell)
        {
            _shouldFocusBell = false;
            try { await bellRef.FocusAsync(); } catch (Exception ex) { Logger.LogDebug(ex, "FocusAsync failed for notification bell"); }
        }

        if (_shouldFocusPanel)
        {
            _shouldFocusPanel = false;
            try { await panelRef.FocusAsync(); } catch (Exception ex) { Logger.LogDebug(ex, "FocusAsync failed for notification panel"); }
        }
    }

    private async Task SafeRefreshAsync()
    {
                await _refreshLock.WaitAsync();
                try
                {
                    await LoadNotificationsAsync();
                    StateHasChanged();
                }
                finally
                {
                    _refreshLock.Release();
                }
    }

    private async Task LoadNotificationsAsync()
    {
        notifications = await Db.Notifications.OrderByDescending(n => n.CreatedAt).Take(50).ToListAsync();
        UnreadCount = await Db.Notifications.CountAsync(n => !n.IsRead);

        // Preload card last4 for all notifications that have a TransactionId.
        // Avoids synchronous Db.Transactions.Find(int) during render which throws
        // InvalidCastException in SQLite (stores PKs as long, not int).
        var txIds = notifications
            .Where(n => n.TransactionId.HasValue)
            .Select(n => n.TransactionId!.Value)
            .Distinct()
            .ToList();
        if (txIds.Count > 0)
        {
            cardLast4Cache = await Db.Transactions
                .Where(t => txIds.Contains(t.Id))
                .ToDictionaryAsync(t => t.Id, t => t.CardLast4 ?? "----");
        }
        else
        {
            cardLast4Cache = new();
        }
    }

    private async Task Toggle()
    {
        if (open)
        {
            CloseAndFocusBell();
            return;
        }

        open = true;
        await SafeRefreshAsync();
        _shouldFocusPanel = true;
    }

    // Escape o click afuera: se cierra y el foco vuelve a la campana.
    private void CloseAndFocusBell()
    {
        if (!open) return;
        open = false;
        _shouldFocusBell = true;
    }

    private bool _drawerRegistered;

    private void OnDrawerChanged(TransactionDto? dto)
    {
        if (dto == null || !open) return;
        open = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseAndFocusBell();
    }


    private string GetLast4(int? txId)
    {
        if (!txId.HasValue) return "----";
        return cardLast4Cache.TryGetValue(txId.Value, out var v) ? v : "----";
    }

    private async Task MarkAllRead()
    {
                var list = await Db.Notifications.Where(n => !n.IsRead).ToListAsync();
                foreach(var n in list) n.IsRead = true;
                await Db.SaveChangesAsync();
                await SafeRefreshAsync();
    }

    private async Task MarkAsRead(int id)
    {
                var n = await Db.Notifications.FindAsync(id);
                if (n != null && !n.IsRead)
                {
                    n.IsRead = true;
                    await Db.SaveChangesAsync();
                    await SafeRefreshAsync();
                }
    }

    private async Task Analyze(int? txId, int? notificationId = null)
    {
                if (notificationId.HasValue)
                {
                    await MarkAsRead(notificationId.Value);
                }

                if (txId != null)
                {
                    var tx = await Db.Transactions.FindAsync(txId.Value);
                    if (tx != null)
                    {
                        DrawerService.Open(new TransactionDto { Id = tx.Id, CardLast4 = tx.CardLast4, Timestamp = tx.OccurredAt ?? DateTime.UtcNow, Amount = tx.Amount, Status = tx.Status, Channel = tx.Provider, ErrorCode = tx.ErrorMessage });
                    }
                }
    }

    public async ValueTask DisposeAsync()
    {
                if (_drawerRegistered) DrawerService.Unregister(OnDrawerChanged);
                if (hubConnection != null)
                {
                    await hubConnection.DisposeAsync();
                }
                _refreshLock.Dispose();
    }
}