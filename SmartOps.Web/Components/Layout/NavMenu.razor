@using Microsoft.AspNetCore.Components.Authorization
<div class="top-row ps-3 navbar" style="background-color:#0f1b2b;color:#fff;">
    <div class="container-fluid">
        <a class="navbar-brand text-white" href="/">SmartOps</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column" style="background-color:#0f1b2b;min-height:100vh;padding-top:1rem;">
        <div class="nav-item px-3 mb-2">
            <NavLink class="nav-link text-white" href="/">
                <span class="bi bi-bar-chart-line me-2" aria-hidden="true"></span> Dashboard
            </NavLink>
        </div>
        <AuthorizeView Roles="Operador,Auditor">
            <Authorized>
                <div class="nav-item px-3 mb-2">
                    <NavLink class="nav-link" href="/diagnostics-history" Match="NavLinkMatch.All">
                        <span class="bi bi-journal-text me-2" aria-hidden="true"></span> Historial de Diagnósticos
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="Auditor">
            <Authorized>
                <div class="nav-item px-3 mb-2">
                    <NavLink class="nav-link" href="/integrations" Match="NavLinkMatch.All">
                        <span class="bi bi-gear me-2" aria-hidden="true"></span> Integraciones
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>
