@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Logging
@inherits LayoutComponentBase

@inject ILogger<MainLayout> Logger
@inject NavigationManager Navigation

@code {
    [CascadingParameter] public Task<AuthenticationState>? authStateTask { get; set; }

    AuthenticationState? authState;

    // Solo para el primer frame: en la ruta del Dashboard el indicador arranca en «Conectando…»
    // (docs/redesign/02-dashboard-cargando.html) hasta que el Dashboard publique el estado real.
    private bool IsDashboardRoute => string.IsNullOrEmpty(Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0]);

    private bool IsAuthenticated => authState?.User.Identity?.IsAuthenticated == true;

    // «email · Rol» del header. Solo presentación: lee los claims que ya trae la sesión.
    private string UserLabel
    {
        get
        {
            var user = authState?.User;
            var name = user?.Identity?.Name ?? string.Empty;
            var roles = user?.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToList();
            return roles is { Count: > 0 } ? $"{name} · {string.Join(", ", roles)}" : name;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (authStateTask != null)
            authState = await authStateTask;
    }
}

<div class="page w-100">
    <header class="app-header">
        <a class="app-header-brand" href="/">
            <img src="/images/logo.png" alt="SmartOps" class="app-header-logo" />
        </a>

        <nav class="app-header-nav" aria-label="Principal">
            <NavLink class="app-header-tab" href="/" Match="NavLinkMatch.All">Dashboard</NavLink>
            <NavLink class="app-header-tab" href="/diagnostics-history">Historial</NavLink>
            <AuthorizeView Roles="Auditor">
                <Authorized>
                    <NavLink class="app-header-tab" href="/integrations">Integraciones</NavLink>
                </Authorized>
            </AuthorizeView>
        </nav>

        <div class="app-header-spacer"></div>

        <div class="app-header-actions">
            @if (IsAuthenticated)
            {
                <DashboardHeaderToggle @rendermode="InteractiveServer" OnDashboard="@IsDashboardRoute" />
            }
            <NotificationBell @rendermode="InteractiveServer" />
            <span class="app-header-sep" aria-hidden="true"></span>
            @if (IsAuthenticated)
            {
                <span class="app-header-user">@UserLabel</span>
                <a class="app-header-link" data-enhance-nav="false" href="/account/logout">Salir</a>
            }
            else
            {
                <a class="app-header-link" href="/login">Iniciar sesión</a>
            }
        </div>
    </header>

    <main class="container-fluid px-4" style="width:100%;">
        <article class="content py-4">
            @Body
        </article>
    </main>
    <TransactionDetailDrawer @rendermode="InteractiveServer" />
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
