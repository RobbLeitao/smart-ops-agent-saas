@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Http
@using Microsoft.Extensions.Logging
@inherits LayoutComponentBase

@inject ILogger<MainLayout> Logger
@inject IHttpContextAccessor HttpContextAccessor

@code {
    [CascadingParameter] public Task<AuthenticationState>? authStateTask { get; set; }

    AuthenticationState? authState;

    // True only for the single request immediately following a successful login (the forced
    // full-page navigation Login.razor performs). Read once from a short-lived, server-only
    // cookie set by the /account/login endpoint, then cleared, so the overlay is part of the
    // very first rendered HTML for that request - no client-side JS delay/gap where the
    // Dashboard would otherwise flash before the overlay appears. Every other request/navigation
    // (tab switches, refreshes) never has this cookie and renders the overlay hidden as usual.
    private bool showTransitionOverlayOnLoad;

    private bool IsAuthenticated => authState?.User.Identity?.IsAuthenticated == true;

    // «email · Rol» del header. Solo presentación: lee los claims que ya trae la sesión.
    private string UserLabel
    {
        get
        {
            var user = authState?.User;
            var name = user?.Identity?.Name ?? string.Empty;
            var roles = user?.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToList();
            return roles is { Count: > 0 } ? $"{name} · {string.Join(", ", roles)}" : name;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (authStateTask != null)
            authState = await authStateTask;
    }

    protected override void OnInitialized()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext != null && httpContext.Request.Cookies.ContainsKey("smartops_transition"))
        {
            showTransitionOverlayOnLoad = true;
            httpContext.Response.Cookies.Delete("smartops_transition", new CookieOptions { Path = "/" });
        }
    }
}

<div id="page-transition-overlay" class="page-transition-overlay @(showTransitionOverlayOnLoad ? "" : "page-transition-hidden")">
    <img src="/images/logo.png" alt="SmartOps" class="page-transition-logo" />
</div>

<div class="page w-100">
    <header class="app-header">
        <a class="app-header-brand" href="/">
            <img src="/images/logo.png" alt="SmartOps" class="app-header-logo" />
        </a>

        <nav class="app-header-nav" aria-label="Principal">
            <NavLink class="app-header-tab" href="/" Match="NavLinkMatch.All">Dashboard</NavLink>
            <NavLink class="app-header-tab" href="/diagnostics-history">Historial</NavLink>
            <AuthorizeView Roles="Auditor">
                <Authorized>
                    <NavLink class="app-header-tab" href="/integrations">Integraciones</NavLink>
                </Authorized>
            </AuthorizeView>
        </nav>

        <div class="app-header-spacer"></div>

        <div class="app-header-actions">
            @if (IsAuthenticated)
            {
                <DashboardHeaderToggle @rendermode="InteractiveServer" />
            }
            <NotificationBell @rendermode="InteractiveServer" />
            <span class="app-header-sep" aria-hidden="true"></span>
            @if (IsAuthenticated)
            {
                <span class="app-header-user">@UserLabel</span>
                <a class="app-header-link" data-enhance-nav="false" href="/account/logout">Salir</a>
            }
            else
            {
                <a class="app-header-link" href="/login">Iniciar sesión</a>
            }
        </div>
    </header>

    <main class="container-fluid px-4" style="width:100%;">
        <article class="content py-4">
            @Body
        </article>
    </main>
    <TransactionDetailDrawer @rendermode="InteractiveServer" />
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
