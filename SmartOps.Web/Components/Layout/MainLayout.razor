@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Logging
@inherits LayoutComponentBase

@inject ILogger<MainLayout> Logger

@code {
    [CascadingParameter] public Task<AuthenticationState>? authStateTask { get; set; }

    AuthenticationState? authState;

    protected override async Task OnParametersSetAsync()
    {
        if (authStateTask != null)
            authState = await authStateTask;
    }
}

<div id="page-transition-overlay" class="page-transition-overlay">
    <img src="/images/logo.png" alt="SmartOps" class="page-transition-logo" />
</div>

<div class="page w-100">
    <header class="header-bar shadow-sm" style="background-color:#212835;border-bottom:1px solid rgba(71,85,103,0.2);">
        <div class="container d-flex align-items-center py-3">
            <a class="navbar-brand me-4 text-white h4 d-flex align-items-center" href="/">
                <img src="/images/logo.png" alt="SmartOps" style="height:34px;object-fit:contain;display:block;" />
            </a>

            <nav class="nav nav-tabs ms-3" style="border-bottom:none;">
                            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                                <i class="bi bi-bar-chart-line nav-icon" aria-hidden="true"></i>
                                <span class="nav-text">Dashboard</span>
                            </NavLink>
                            <NavLink class="nav-link" href="/diagnostics-history">
                                <i class="bi bi-clock-history nav-icon" aria-hidden="true"></i>
                                <span class="nav-text">Historial</span>
                            </NavLink>
                            <AuthorizeView Roles="Auditor">
                                <Authorized>
                                    <NavLink class="nav-link" href="/integrations">
                                        <i class="bi bi-plug nav-icon" aria-hidden="true"></i>
                                        <span class="nav-text">Integraciones</span>
                                    </NavLink>
                                </Authorized>
                            </AuthorizeView>
                        </nav>

            <div class="ms-auto text-slate-400 small d-flex align-items-center gap-3">
                <NotificationBell @rendermode="InteractiveServer" />
                <div class="text-slate-400 small me-3">Centro de Operaciones</div>
                @if (authState != null && authState.User.Identity != null && authState.User.Identity.IsAuthenticated)
                {
                    <div class="text-slate-200 small">@authState.User.Identity.Name</div>
                    <a class="btn btn-sm" data-enhance-nav="false" style="background:transparent;color:#cbd5e1;border:1px solid rgba(148,163,184,0.08);padding:6px 10px;border-radius:8px;text-decoration:none;" href="/account/logout">Cerrar Sesión</a>
                }
                else
                {
                    <a class="btn btn-sm" style="background:transparent;color:#cbd5e1;border:1px solid rgba(148,163,184,0.08);padding:6px 10px;border-radius:8px;" href="/login">Iniciar Sesión</a>
                }
            </div>
        </div>
    </header>

    <main class="container-fluid px-4" style="width:100%;">
        <article class="content py-4">
            @Body
        </article>
    </main>
    <TransactionDetailDrawer @rendermode="InteractiveServer" />
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
