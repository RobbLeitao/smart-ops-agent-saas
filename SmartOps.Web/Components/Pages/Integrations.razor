@page "/integrations"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Auditor")]
@using SmartOps.Infrastructure.Data
@using SmartOps.Core.Entities
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db

<div class="min-vh-100 py-5" style="background-color:transparent;">
    <div class="container-fluid">
        <div class="grid-dark p-4" style="background-color:#1e2330;">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
                <div>
                    <h2 class="mb-1 text-slate-100">Configuración de Integraciones</h2>
                    <small class="text-slate-400">Ajustá el proveedor de IA y la orquestación del motor</small>
                </div>
                <span class="badge rounded-pill px-3 py-2" style="background:#13233a;color:#67e8f9;border:1px solid rgba(103,232,249,0.18);">
                    Microsoft Semantic Kernel - Activo
                </span>
            </div>

            <div class="mb-4">
                <div class="text-cyan-300 small mb-2">Orquestación</div>
                <div class="p-3 rounded-4" style="background:#171c26;border:1px solid rgba(148,163,184,0.14);">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                        <div>
                            <div class="text-slate-100 fw-semibold">Motor principal</div>
                            <div class="text-slate-400 small">La aplicación usa Semantic Kernel para enrutar prompts y herramientas.</div>
                        </div>
                        <span class="badge rounded-pill" style="background:#0f2a2c;color:#5eead4;border:1px solid rgba(94,234,212,0.18);">Activo</span>
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <div class="text-cyan-300 small mb-3">Proveedor de IA</div>
                <div class="row g-3">
                    <div class="col-lg-6">
                        <button class="@ProviderCardClass(ModelProvider.Local)" @onclick="() => SelectProvider(ModelProvider.Local)">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="text-slate-100 fw-semibold">Simulador Local</div>
                                    <div class="text-slate-400 small">Costo $0 · Ideal para desarrollo y pruebas</div>
                                </div>
                                <span class="badge rounded-pill" style="background:#1f2937;color:#cbd5e1;">Recomendado</span>
                            </div>
                        </button>
                    </div>
                    <div class="col-lg-6">
                        <button class="@ProviderCardClass(ModelProvider.OpenAI)" @onclick="() => SelectProvider(ModelProvider.OpenAI)">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="text-slate-100 fw-semibold">OpenAI API / Azure OpenAI</div>
                                    <div class="text-slate-400 small">Conecta el modelo real para producción</div>
                                </div>
                                <span class="badge rounded-pill" style="background:#13233a;color:#67e8f9;">Producción</span>
                            </div>
                        </button>
                    </div>
                </div>
            </div>

            @if (SelectedProvider == ModelProvider.OpenAI)
            {
                <div class="mb-4 p-4 rounded-4" style="background:#171c26;border:1px solid rgba(148,163,184,0.14);">
                    <div class="text-cyan-300 small mb-3">Credenciales</div>
                    <div class="row g-3">
                        <div class="col-lg-6">
                            <label class="form-label text-slate-200">API Key <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input class="form-control bg-[#11151b] border-0 text-slate-200 @(ShowValidationErrors && string.IsNullOrWhiteSpace(ApiKey) ? "is-invalid" : string.Empty)" type="@ApiKeyInputType" @bind="ApiKey" placeholder="sk-..." />
                                <button class="btn btn-outline-secondary" type="button" @onclick="ToggleApiKeyVisibility">
                                    @(ShowApiKey ? "Ocultar" : "Mostrar")
                                </button>
                            </div>
                            @if (ShowValidationErrors && string.IsNullOrWhiteSpace(ApiKey))
                            {
                                <div class="text-danger small mt-1">La API Key es obligatoria.</div>
                            }
                        </div>
                        <div class="col-lg-6">
                            <label class="form-label text-slate-200">Model ID <span class="text-danger">*</span></label>
                            <input class="form-control bg-[#11151b] border-0 text-slate-200 @(ShowValidationErrors && string.IsNullOrWhiteSpace(ModelId) ? "is-invalid" : string.Empty)" @bind="ModelId" placeholder="gpt-4o" />
                            @if (ShowValidationErrors && string.IsNullOrWhiteSpace(ModelId))
                            {
                                <div class="text-danger small mt-1">El Model ID es obligatorio.</div>
                            }
                        </div>
                    </div>
                </div>
            }

            <div class="d-flex align-items-center gap-3 flex-wrap">
                <button class="btn btn-ia px-4" @onclick="SaveConfigurationAsync" disabled="@IsSaving">
                    @if (IsSaving)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Guardando...</span>
                    }
                    else
                    {
                        <span>Guardar Configuración</span>
                    }
                </button>
                <small class="text-slate-400">La configuración se simula por ahora y queda lista para persistencia real.</small>
            </div>

            @if (ShowToast)
            {
                <div class="mt-4 toast-soft show">
                    Configuración actualizada correctamente
                </div>
            }

            @if (ShowValidationErrors && SelectedProvider == ModelProvider.OpenAI && (string.IsNullOrWhiteSpace(ApiKey) || string.IsNullOrWhiteSpace(ModelId)))
            {
                <div class="mt-4 alert alert-danger">
                    Completá API Key y Model ID antes de guardar la configuración.
                </div>
            }
        </div>
    </div>
</div>

@code {
    private enum ModelProvider
    {
        Local,
        OpenAI
    }

    private ModelProvider SelectedProvider = ModelProvider.Local;
    private string ApiKey = string.Empty;
    private string ModelId = "gpt-4o";
    private bool ShowApiKey;
    private bool IsSaving;
    private bool ShowToast;
    private bool ShowValidationErrors;

    private string ApiKeyInputType => ShowApiKey ? "text" : "password";

    private string ProviderCardClass(ModelProvider provider)
        => $"integration-card {(SelectedProvider == provider ? "active" : string.Empty)}";

    private void SelectProvider(ModelProvider provider)
    {
        SelectedProvider = provider;
        if (provider == ModelProvider.Local)
        {
            ShowValidationErrors = false;
        }
    }

    private void ToggleApiKeyVisibility()
    {
        ShowApiKey = !ShowApiKey;
    }

    protected override async Task OnInitializedAsync()
    {
        // Load saved settings from DB (Settings key-value)
        try
        {
            using var conn = Db.Database.GetDbConnection();
            if (conn.State != System.Data.ConnectionState.Open) conn.Open();
            using var cmd = conn.CreateCommand();
            cmd.CommandText = "SELECT Value FROM Settings WHERE Key = @k";
            var p = cmd.CreateParameter(); p.ParameterName = "@k"; p.Value = "Integrations.Provider"; cmd.Parameters.Add(p);
            var val = cmd.ExecuteScalar() as string;
            if (!string.IsNullOrWhiteSpace(val) && Enum.TryParse<ModelProvider>(val, out var prov)) SelectedProvider = prov;

            cmd.Parameters.Clear(); p = cmd.CreateParameter(); p.ParameterName = "@k"; p.Value = "Integrations.ApiKey"; cmd.Parameters.Add(p);
            val = cmd.ExecuteScalar() as string; if (!string.IsNullOrWhiteSpace(val)) ApiKey = val;

            cmd.Parameters.Clear(); p = cmd.CreateParameter(); p.ParameterName = "@k"; p.Value = "Integrations.ModelId"; cmd.Parameters.Add(p);
            val = cmd.ExecuteScalar() as string; if (!string.IsNullOrWhiteSpace(val)) ModelId = val;
        }
        catch
        {
            // ignore load errors
        }
    }

    private async Task SaveConfigurationAsync()
    {
        ShowValidationErrors = true;

        if (SelectedProvider == ModelProvider.OpenAI &&
            (string.IsNullOrWhiteSpace(ApiKey) || string.IsNullOrWhiteSpace(ModelId)))
        {
            StateHasChanged();
            return;
        }

        IsSaving = true;
        ShowToast = false;
        StateHasChanged();

        try
        {
            using var conn = Db.Database.GetDbConnection();
            if (conn.State != System.Data.ConnectionState.Open) conn.Open();
            using var tran = conn.BeginTransaction();
            using var cmd = conn.CreateCommand();
            cmd.Transaction = tran;
            cmd.CommandText = "INSERT OR REPLACE INTO Settings (Key,Value) VALUES (@k,@v);";
            var pK = cmd.CreateParameter(); pK.ParameterName = "@k"; cmd.Parameters.Add(pK);
            var pV = cmd.CreateParameter(); pV.ParameterName = "@v"; cmd.Parameters.Add(pV);

            pK.Value = "Integrations.Provider"; pV.Value = SelectedProvider.ToString(); cmd.ExecuteNonQuery();
            pK.Value = "Integrations.ApiKey"; pV.Value = ApiKey ?? string.Empty; cmd.ExecuteNonQuery();
            pK.Value = "Integrations.ModelId"; pV.Value = ModelId ?? string.Empty; cmd.ExecuteNonQuery();

            tran.Commit();
            ShowToast = true;
            ShowValidationErrors = false;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Failed to save integrations settings: {ex}");
        }
        finally
        {
            IsSaving = false;
            StateHasChanged();
            await Task.Delay(1500);
            ShowToast = false;
            StateHasChanged();
        }
    }
}
