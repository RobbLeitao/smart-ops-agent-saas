@page "/integrations"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Auditor")]
@using SmartOps.Web.Services
@inject IntegrationSettingsStore Store
@inject IAiConnectionTester ConnectionTester

<PageTitle>Integraciones · SmartOps</PageTitle>

@* Integraciones (docs/redesign/05-integraciones.html). *@
<div class="intg">
    <div>
        <h1 class="intg-title">Integraciones</h1>
        <p class="intg-subtitle">Elegí qué motor genera los diagnósticos. Los cambios se aplican en el próximo diagnóstico.</p>
    </div>

    <form class="intg-form" novalidate @onsubmit="SaveConfigurationAsync">
        <fieldset class="intg-providers">
            <legend class="intg-legend">Proveedor de IA</legend>

            @foreach (var option in ProviderOptions)
            {
                var selected = SelectedProvider == option.Provider;
                <label class="intg-option @(selected ? "is-selected" : null)" data-provider="@option.Provider">
                    <input class="intg-radio" type="radio" name="provider" value="@option.Provider"
                           checked="@selected" @onchange="() => SelectProvider(option.Provider)" />
                    <span class="intg-option-body">
                        <span class="intg-option-head">
                            <span class="intg-option-name">@option.Name</span>
                            <span class="intg-chip">@option.Chip</span>
                        </span>
                        <span class="intg-option-desc">@option.Description</span>
                    </span>
                </label>
            }

            <p class="intg-footnote">Orquestado con Microsoft Semantic Kernel.</p>
        </fieldset>

        <section class="intg-panel" aria-labelledby="cred-title">
            <div class="intg-panel-head">
                <h2 id="cred-title" class="intg-panel-title">@PanelTitle</h2>
                <p class="intg-panel-note">Solo los Auditores ven y editan esta configuración.</p>
            </div>

            <div class="intg-panel-body">
                @if (!IsRealProvider)
                {
                    <p class="intg-empty">El simulador no necesita credenciales.</p>
                }
                else
                {
                    <div class="ds-field">
                        <label class="ds-label" for="intg-apikey">API key</label>
                        <span class="ds-reveal">
                            <input id="intg-apikey" class="ds-input mono" type="@(ShowApiKey ? "text" : "password")"
                                   autocomplete="off" spellcheck="false"
                                   aria-invalid="@(ApiKeyError is not null ? "true" : "false")"
                                   aria-describedby="intg-apikey-help @(ApiKeyError is not null ? "intg-apikey-error" : null)"
                                   @bind="ApiKey" @bind:after="OnFieldChanged" />
                            <button type="button" class="ds-reveal-btn" aria-controls="intg-apikey" aria-pressed="@(ShowApiKey ? "true" : "false")"
                                    @onclick="ToggleApiKeyVisibility">@(ShowApiKey ? "Ocultar" : "Mostrar")</button>
                        </span>
                        @if (ApiKeyError is not null)
                        {
                            <span id="intg-apikey-error" class="ds-error">@ApiKeyError</span>
                        }
                        <span id="intg-apikey-help" class="ds-help">Se muestra oculta por defecto. Nunca aparece en logs ni en mensajes de error.</span>
                    </div>

                    <div class="ds-field">
                        <label class="ds-label" for="intg-model">@(IsAzure ? "Deployment / modelo" : "Modelo")</label>
                        <input id="intg-model" class="ds-input mono" type="text" autocomplete="off" spellcheck="false"
                               placeholder="@(IsAzure ? "nombre-del-deployment" : "gpt-4o")"
                               aria-invalid="@(ModelIdError is not null ? "true" : "false")"
                               aria-describedby="intg-model-help @(ModelIdError is not null ? "intg-model-error" : null)"
                               @bind="ModelId" @bind:after="OnFieldChanged" />
                        @if (ModelIdError is not null)
                        {
                            <span id="intg-model-error" class="ds-error">@ModelIdError</span>
                        }
                        <span id="intg-model-help" class="ds-help">
                            @(IsAzure ? "El nombre del deployment en Azure AI Studio." : "El ID exacto que publica el proveedor, con prefijo si lo tiene.")
                        </span>
                    </div>

                    <div class="ds-field">
                        <label class="ds-label" for="intg-endpoint">Endpoint @if (!IsAzure) {<span class="ds-label-optional">(opcional)</span>}</label>
                        <input id="intg-endpoint" class="ds-input mono" type="url" autocomplete="off" spellcheck="false"
                               placeholder="@(IsAzure ? "https://mi-recurso.openai.azure.com/" : "https://api.openai.com/v1")"
                               aria-invalid="@(EndpointError is not null ? "true" : "false")"
                               aria-describedby="intg-endpoint-help @(EndpointError is not null ? "intg-endpoint-error" : null)"
                               @bind="Endpoint" @bind:after="OnFieldChanged" />
                        @if (EndpointError is not null)
                        {
                            <span id="intg-endpoint-error" class="ds-error">@EndpointError</span>
                        }
                        <span id="intg-endpoint-help" class="ds-help">
                            @if (IsAzure)
                            {
                                <span>La URL del recurso de Azure OpenAI.</span>
                            }
                            else
                            {
                                <span>Vacío usa OpenAI. Para Groq: <span class="mono">https://api.groq.com/openai/v1</span></span>
                            }
                        </span>
                    </div>
                }

                @if (TestResult is not null)
                {
                    if (TestResult.Ok)
                    {
                        <div class="ds-alert ds-alert-success intg-result" role="status">
                            <svg class="ds-alert-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg>
                            <span>Conexión correcta con <span class="mono">@TestedModel</span></span>
                        </div>
                    }
                    else
                    {
                        <div class="ds-alert ds-alert-danger intg-result" role="alert">
                            <svg class="ds-alert-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v6M12 16.5v.5"></path></svg>
                            <span>@TestResult.Message</span>
                        </div>
                    }
                }

                @if (Saved)
                {
                    <div class="ds-alert ds-alert-success intg-saved" role="status">
                        <svg class="ds-alert-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg>
                        <span>Configuración guardada</span>
                    </div>
                }
                else if (SaveFailed)
                {
                    <div class="ds-alert ds-alert-danger" role="alert">
                        <svg class="ds-alert-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v6M12 16.5v.5"></path></svg>
                        <span>No pudimos guardar la configuración. Probá de nuevo.</span>
                    </div>
                }
            </div>

            <div class="intg-panel-foot">
                @if (IsRealProvider)
                {
                    <button type="button" class="btn-ds btn-ds-secondary intg-test" disabled="@(IsTesting || IsSaving)" @onclick="TestConnectionAsync">
                        @(IsTesting ? "Probando…" : "Probar conexión")
                    </button>
                }
                <button type="submit" class="btn-ds btn-ds-primary intg-save" disabled="@(IsSaving || IsTesting)">
                    @(IsSaving ? "Guardando…" : "Guardar cambios")
                </button>
            </div>
        </section>
    </form>
</div>

@code {
    // Persisted as-is in Settings["Integrations.Provider"] (see IntegrationSettingsStore).
    private enum ModelProvider
    {
        Local,
        OpenAI,
        AzureOpenAI
    }

    private sealed record ProviderOption(ModelProvider Provider, string Name, string Chip, string Description);

    private static readonly ProviderOption[] ProviderOptions =
    {
        new(ModelProvider.Local, "Simulador local", "Gratis", "Respuestas de ejemplo sin llamar a ningún modelo. Para desarrollo y demos."),
        new(ModelProvider.OpenAI, "OpenAI o compatible", "Modelo real", "OpenAI, Groq u otro proveedor con la misma API."),
        new(ModelProvider.AzureOpenAI, "Azure OpenAI", "Modelo real", "Un deployment propio en Azure AI Studio."),
    };

    private ModelProvider SelectedProvider = ModelProvider.Local;
    private string ApiKey = string.Empty;
    private string ModelId = string.Empty;
    private string Endpoint = string.Empty;

    private bool ShowApiKey;
    private bool IsSaving;
    private bool IsTesting;
    private bool Saved;
    private bool SaveFailed;
    private bool ShowValidationErrors;
    private ConnectionTestResult? TestResult;
    private string TestedModel = string.Empty;

    // Each real provider keeps its own values: switching shows that provider's draft, never the other one's.
    private readonly Dictionary<ModelProvider, ProviderCredentials> _drafts = new();

    private bool IsRealProvider => SelectedProvider is ModelProvider.OpenAI or ModelProvider.AzureOpenAI;
    private bool IsAzure => SelectedProvider == ModelProvider.AzureOpenAI;

    private string PanelTitle => SelectedProvider switch
    {
        ModelProvider.OpenAI => "Credenciales de OpenAI o compatible",
        ModelProvider.AzureOpenAI => "Credenciales de Azure OpenAI",
        _ => "Simulador local"
    };

    private string? ApiKeyError =>
        ShowValidationErrors && IsRealProvider && string.IsNullOrWhiteSpace(ApiKey) ? "La API key es obligatoria." : null;

    private string? ModelIdError =>
        ShowValidationErrors && IsRealProvider && string.IsNullOrWhiteSpace(ModelId)
            ? (IsAzure ? "El deployment es obligatorio." : "El modelo es obligatorio.")
            : null;

    private string? EndpointError
    {
        get
        {
            if (!ShowValidationErrors || !IsRealProvider) return null;
            if (IsAzure)
            {
                if (string.IsNullOrWhiteSpace(Endpoint)) return "El endpoint de Azure OpenAI es obligatorio.";
                return Uri.TryCreate(Endpoint.Trim(), UriKind.Absolute, out var uri) && uri.Scheme == Uri.UriSchemeHttps
                    ? null
                    : OpenAICompatibleEndpointValidator.InvalidUriMessage;
            }
            return OpenAICompatibleEndpointValidator.TryValidate(Endpoint, out _, out var error) ? null : error;
        }
    }

    private bool IsValid
    {
        get
        {
            var previous = ShowValidationErrors;
            ShowValidationErrors = true;
            var valid = ApiKeyError is null && ModelIdError is null && EndpointError is null;
            ShowValidationErrors = previous;
            return valid;
        }
    }

    protected override void OnInitialized()
    {
        try
        {
            foreach (var provider in new[] { ModelProvider.OpenAI, ModelProvider.AzureOpenAI })
            {
                _drafts[provider] = Store.Read(provider.ToString());
            }
            SelectedProvider = Enum.Parse<ModelProvider>(Store.ReadActiveProvider());
            LoadDraft(SelectedProvider);
        }
        catch
        {
            // Settings table missing (fresh DB): start empty.
        }
    }

    private void StashDraft()
    {
        if (IsRealProvider) _drafts[SelectedProvider] = new(ApiKey, ModelId, Endpoint);
    }

    private void LoadDraft(ModelProvider provider)
    {
        var c = _drafts.TryGetValue(provider, out var d) ? d : ProviderCredentials.Empty;
        ApiKey = c.ApiKey;
        ModelId = c.ModelId;
        Endpoint = c.Endpoint;
    }

    private void SelectProvider(ModelProvider provider)
    {
        if (provider == SelectedProvider) return;
        StashDraft();
        SelectedProvider = provider;
        LoadDraft(provider);
        ShowApiKey = false;
        ShowValidationErrors = false;
        ClearFeedback();
    }

    private void OnFieldChanged() => ClearFeedback();

    private void ClearFeedback()
    {
        TestResult = null;
        Saved = false;
        SaveFailed = false;
    }

    private void ToggleApiKeyVisibility() => ShowApiKey = !ShowApiKey;

    private async Task TestConnectionAsync()
    {
        if (IsTesting || !IsRealProvider) return;
        ClearFeedback();
        ShowValidationErrors = true;
        if (!IsValid) return;

        IsTesting = true;
        TestedModel = ModelId.Trim();
        try
        {
            TestResult = await ConnectionTester.TestAsync(SelectedProvider.ToString(), ApiKey, ModelId, Endpoint);
        }
        finally
        {
            IsTesting = false;
        }
    }

    private Task SaveConfigurationAsync()
    {
        if (IsSaving) return Task.CompletedTask;
        ClearFeedback();
        ShowValidationErrors = true;
        if (IsRealProvider && !IsValid) return Task.CompletedTask;

        IsSaving = true;
        try
        {
            Store.Save(SelectedProvider.ToString(), IsRealProvider ? new ProviderCredentials(ApiKey, ModelId, Endpoint) : null);
            StashDraft();
            Saved = true;
            ShowValidationErrors = false;
        }
        catch (Exception ex)
        {
            SaveFailed = true;
            Console.Error.WriteLine($"Failed to save integrations settings: {ex.GetType().Name}");
        }
        finally
        {
            IsSaving = false;
        }
        return Task.CompletedTask;
    }
}
