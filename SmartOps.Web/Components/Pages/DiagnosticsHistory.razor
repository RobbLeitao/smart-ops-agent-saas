@page "/diagnostics-history"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization
@using SmartOps.Web.Services
@inject SmartOps.Infrastructure.Data.AppDbContext Db
@inject DbContextGate DbGate
@inject DiagnosticReportService ReportService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject Microsoft.Extensions.Logging.ILogger<DiagnosticsHistory> Logger

<PageTitle>Historial de diagnósticos · SmartOps</PageTitle>

@* Historial de diagnósticos (docs/redesign/04-historial.html). *@
<LoggingErrorBoundary>
<div class="hist">
    <div class="hist-head">
        <h1 class="hist-title">Historial de diagnósticos</h1>
        <p class="hist-subtitle" aria-live="polite">
            @if (_result is null)
            {
                <span>Cargando diagnósticos…</span>
            }
            else
            {
                <span>@_result.Total @(_result.Total == 1 ? "diagnóstico generado" : "diagnósticos generados") por el motor. Elegí uno para ver el detalle.</span>
            }
        </p>
    </div>

    <form class="hist-filters" role="search" aria-label="Filtros del historial" @onsubmit="ApplyFiltersAsync" @onsubmit:preventDefault>
        <label class="hist-field">
            <span class="hist-label">Tarjeta</span>
            <span class="hist-search">
                <svg class="hist-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
                <input type="text" class="form-control hist-input-card" inputmode="numeric" maxlength="4" autocomplete="off"
                       placeholder="Últimos 4 dígitos" value="@_card" @oninput="OnCardInputAsync" />
            </span>
        </label>
        <label class="hist-field">
            <span class="hist-label">Desde</span>
            <input type="date" class="form-control hist-input-date" @bind="_from" @bind:after="ApplyFiltersAsync" />
        </label>
        <label class="hist-field">
            <span class="hist-label">Hasta</span>
            <input type="date" class="form-control hist-input-date" @bind="_to" @bind:after="ApplyFiltersAsync" />
        </label>
        <label class="hist-field">
            <span class="hist-label">Valoración</span>
            <select class="form-select hist-input-date" @bind="_vote" @bind:after="ApplyFiltersAsync">
                <option value="@VoteFilter.All">Todas</option>
                <option value="@VoteFilter.Useful">Útiles</option>
                <option value="@VoteFilter.NotUseful">No útiles</option>
                <option value="@VoteFilter.Unvoted">Sin votar</option>
            </select>
        </label>
        @if (_canSeeAll)
        {
            <label class="hist-check">
                <input type="checkbox" class="form-check-input" @bind="_onlyMine" @bind:after="ApplyFiltersAsync" />
                Solo los míos
            </label>
        }
        <div class="hist-filters-spacer"></div>
        <button type="button" class="btn-ds btn-ds-link hist-clear" @onclick="ClearFiltersAsync">Limpiar filtros</button>
    </form>

    <div class="hist-layout">
        <section class="hist-table-card" aria-label="Diagnósticos">
            @if (_result is null)
            {
                <p class="hist-muted hist-state m-0" role="status">Cargando…</p>
            }
            else if (_result.Total == 0)
            {
                <div class="hist-empty">
                    @if (Filters.IsEmpty)
                    {
                        <p class="m-0">Todavía no hay diagnósticos.</p>
                    }
                    else
                    {
                        <p class="m-0">No hay diagnósticos con estos filtros</p>
                        <button type="button" class="btn-ds btn-ds-secondary" @onclick="ClearFiltersAsync">Limpiar filtros</button>
                    }
                </div>
            }
            else
            {
                <div class="hist-table-scroll">
                    <table class="table hist-table m-0">
                        <thead>
                            <tr>
                                <th scope="col">Fecha</th>
                                <th scope="col">TX</th>
                                <th scope="col">Tarjeta</th>
                                <th scope="col">Motivo</th>
                                <th scope="col">Operador</th>
                                <th scope="col">Valoración</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _result.Rows)
                            {
                                var selected = row.Id == _selectedId;
                                <tr @key="row.Id" class="hist-row @(selected ? "is-selected" : "")" aria-selected="@(selected ? "true" : "false")"
                                    @onclick="() => SelectAsync(row.Id)">
                                    <td class="hist-cell-link">
                                        <a href="diagnostics-history#diagnostico-@row.Id" class="hist-row-link mono" aria-current="@(selected ? "true" : null)"
                                           aria-label="Ver diagnóstico de la TX @row.TransactionId del @HistoryFormat.ShortDate(row.CreatedAtUtc)"
                                           @onclick="() => SelectAsync(row.Id)" @onclick:preventDefault @onclick:stopPropagation>@HistoryFormat.ShortDate(row.CreatedAtUtc)</a>
                                    </td>
                                    <td class="mono">@row.TransactionId</td>
                                    <td class="mono">@HistoryFormat.Card(row.CardLast4)</td>
                                    <td><span class="hist-reason"><span class="dot dot-sm dot-danger" aria-hidden="true"></span>@HistoryFormat.Reason(row.Reason)</span></td>
                                    <td class="hist-muted">@OperatorName.Short(row.OperatorEmail)</td>
                                    <td>
                                        @switch (row.UserVote)
                                        {
                                            case true:
                                                <span class="hist-vote-cell"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg>Útil</span>
                                                break;
                                            case false:
                                                <span class="hist-vote-cell">No útil</span>
                                                break;
                                            default:
                                                <span class="hist-muted">Sin votar</span>
                                                break;
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="hist-pager">
                    <span>Mostrando @_result.FirstIndex–@_result.LastIndex de @_result.Total</span>
                    <div class="hist-pager-buttons">
                        <button type="button" class="btn-ds btn-ds-secondary hist-pager-btn" disabled="@(!_result.HasPrevious || _loading)" @onclick="() => GoToPageAsync(_result.Page - 1)">Anterior</button>
                        <button type="button" class="btn-ds btn-ds-secondary hist-pager-btn" disabled="@(!_result.HasNext || _loading)" @onclick="() => GoToPageAsync(_result.Page + 1)">Siguiente</button>
                    </div>
                </div>
            }
        </section>

        @if (_detail is not null && _result is { Total: > 0 })
        {
            <DiagnosticDetailPanel Detail="@_detail" UserId="@_userId" OnVoted="OnVoted"
                                   OnExportPdf="ExportPdfAsync" OnExportJson="ExportJsonAsync" ExportNotice="@_exportNotice" />
        }
    </div>
</div>
</LoggingErrorBoundary>

@code {
    internal const string PopupBlockedNotice = "El navegador bloqueó la ventana del informe. Permití las ventanas emergentes para este sitio y probá de nuevo.";

    private string? _userId;
    private string? _userEmail;
    private bool _canSeeAll;

    private string _card = string.Empty;
    private DateTime? _from;
    private DateTime? _to;
    private VoteFilter _vote = VoteFilter.All;
    private bool _onlyMine;

    private HistoryPage? _result;
    private int _page = 1;
    private bool _loading;
    private int _loadVersion;

    private Guid? _selectedId;
    private HistoryDetail? _detail;
    private int _detailVersion;
    private string? _exportNotice;

    private HistoryFilters Filters => new(_card, _from, _to, _vote, _canSeeAll && _onlyMine);

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        _userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        _userEmail = user.Identity?.Name;
        _canSeeAll = user.IsInRole("Auditor") || user.IsInRole("Admin");

        await LoadAsync(1);
    }

    private async Task LoadAsync(int page)
    {
        var version = ++_loadVersion;
        _loading = true;
        try
        {
            var result = await DbGate.RunAsync(() => DiagnosticsHistoryQuery.GetPageAsync(Db, Filters, _userId, _canSeeAll, page));
            if (version != _loadVersion) return;

            _result = result;
            _page = result.Page;
            await ResolveSelectionAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load the diagnostics history");
            if (version == _loadVersion) _result ??= new HistoryPage(Array.Empty<HistoryRow>(), 0, 1, DiagnosticsHistoryQuery.DefaultPageSize);
        }
        finally
        {
            if (version == _loadVersion) _loading = false;
        }
    }

    // Al entrar se selecciona el primero; al cambiar de página o de filtros, si el seleccionado ya no está
    // visible, el primero visible (HistorySelection.Resolve).
    private async Task ResolveSelectionAsync()
    {
        var rows = _result?.Rows ?? Array.Empty<HistoryRow>();
        var next = HistorySelection.Resolve(_selectedId, rows.Select(r => r.Id).ToList());

        if (next is null)
        {
            _selectedId = null;
            _detail = null;
            return;
        }

        if (next == _selectedId && _detail is not null) return;
        await ShowDetailAsync(rows.First(r => r.Id == next));
    }

    private async Task SelectAsync(Guid id)
    {
        if (id == _selectedId) return;
        var row = _result?.Rows.FirstOrDefault(r => r.Id == id);
        if (row is null) return;
        await ShowDetailAsync(row);
    }

    private async Task ShowDetailAsync(HistoryRow row)
    {
        var version = ++_detailVersion;
        _selectedId = row.Id;
        _exportNotice = null;
        _detail = HistoryDetail.FromRow(row);
        StateHasChanged();

        try
        {
            var markdown = await DbGate.RunAsync(() => Db.Diagnostics.AsNoTracking()
                .Where(d => d.Id == row.Id)
                .Select(d => d.Markdown)
                .FirstOrDefaultAsync());
            if (version != _detailVersion) return;
            _detail = HistoryDetail.FromRow(row, markdown ?? string.Empty);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load diagnostic {Id}", row.Id);
            if (version == _detailVersion) _detail = HistoryDetail.FromRow(row, string.Empty);
        }
    }

    private async Task OnCardInputAsync(ChangeEventArgs e)
    {
        _card = e.Value?.ToString() ?? string.Empty;
        await ApplyFiltersAsync();
    }

    private Task ApplyFiltersAsync() => LoadAsync(1);

    private Task GoToPageAsync(int page) => LoadAsync(page);

    private Task ClearFiltersAsync()
    {
        _card = string.Empty;
        _from = null;
        _to = null;
        _vote = VoteFilter.All;
        _onlyMine = false;
        return LoadAsync(1);
    }

    // El voto se guardó en el panel: se refleja en la columna Valoración sin recargar la página (la fila no
    // desaparece aunque el filtro activo ya no la incluya; se va al cambiar de página o de filtros).
    private void OnVoted((Guid DiagnosticId, bool IsUseful) vote)
    {
        if (_result is null) return;
        var rows = _result.Rows.Select(r => r.Id == vote.DiagnosticId ? r with { UserVote = vote.IsUseful } : r).ToList();
        _result = _result with { Rows = rows };
    }

    private async Task ExportPdfAsync()
    {
        if (_selectedId is not { } id) return;
        _exportNotice = null;

        try
        {
            var html = await ReportService.BuildHtmlAsync(id, _userId, _userEmail, Navigation.BaseUri);
            if (html is null) return;
            var opened = await JS.InvokeAsync<bool>("smartOpsOpenPrintView", html);
            if (!opened) _exportNotice = PopupBlockedNotice;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to export the PDF of diagnostic {Id}", id);
            _exportNotice = "No se pudo generar el informe. Probá de nuevo.";
        }
    }

    private async Task ExportJsonAsync()
    {
        if (_selectedId is not { } id) return;
        _exportNotice = null;

        try
        {
            var diagnostic = await DbGate.RunAsync(() => Db.Diagnostics.AsNoTracking().FirstOrDefaultAsync(d => d.Id == id));
            if (diagnostic is null) return;
            var (fileName, json) = DiagnosticJsonExport.Build(diagnostic);
            await JS.InvokeVoidAsync("smartOpsDownloadFile", fileName, "application/json", json);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to export the JSON of diagnostic {Id}", id);
            _exportNotice = "No se pudo exportar el JSON. Probá de nuevo.";
        }
    }
}
