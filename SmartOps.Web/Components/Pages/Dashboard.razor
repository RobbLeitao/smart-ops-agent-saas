@page "/"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IAsyncDisposable
@using SmartOps.Core.Entities
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.SignalR.Client
@inject Microsoft.Extensions.Logging.ILogger<Dashboard> Logger
@inject SmartOps.Infrastructure.Data.AppDbContext Db
@inject SmartOps.Web.Services.DiagnosticOrchestratorService Orchestrator
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<div class="dashboard-shell min-vh-100 py-5">
    <div class="container-fluid">
        <section class="dashboard-panel dashboard-hero mb-4">
            <div class="d-flex flex-column flex-xl-row gap-3 justify-content-between align-items-xl-center dashboard-hero-inner">
                <div>
                    <div class="dashboard-chip mb-3">
                        <i class="bi bi-broadcast"></i>
                        <span>Centro de operaciones de IA</span>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <span class="dashboard-chip">
                        <i class="bi bi-activity"></i>
                        <span>@DiagnosticsCount diagnósticos</span>
                        <button type="button" class="btn btn-sm btn-outline-light dashboard-chip-action" @onclick="OpenChartsModal">
                            <i class="bi bi-graph-up"></i>
                            <span>Ver gráficos</span>
                        </button>
                    </span>
                    <span class="dashboard-chip"><i class="bi bi-shield-check"></i><span>@SuccessRateDisplay aprobación</span></span>
                    <span class="dashboard-chip"><i class="bi bi-robot"></i><span>@UsefulPercentDisplay IA útil</span></span>
                </div>

                <div class="ms-3">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleRealtime">@(realtimePaused ? "Reanudar notificaciones" : "Pausar notificaciones")</button>
                </div>
            </div>
        </section>

        <section class="dashboard-kpi-grid mb-4">
            <article class="dashboard-panel dashboard-metric-card" style="--accent:#22d3ee;">
                <div class="dashboard-metric-label">Tasa de Aprobación (%)</div>
                <div class="dashboard-metric-value">@SuccessRateDisplay</div>
                <div class="dashboard-metric-subtitle">Sobre el conjunto de transacciones cargado.</div>
            </article>

            <article class="dashboard-panel dashboard-metric-card" style="--accent:#ef4444;">
                <div class="dashboard-metric-label">Transacciones Fallidas</div>
                <div class="dashboard-metric-value">@FailedTransactionsCount</div>
                <div class="dashboard-metric-subtitle">Casos listos para análisis o revisión.</div>
            </article>

            <article class="dashboard-panel dashboard-metric-card" style="--accent:#8b5cf6;">
                <div class="dashboard-metric-label">Diagnósticos Realizados por IA</div>
                <div class="dashboard-metric-value">@DiagnosticsCount</div>
                <div class="dashboard-metric-subtitle">Resultados generados por el motor inteligente.</div>
            </article>

            <article class="dashboard-panel dashboard-metric-card" style="--accent:#14b8a6;">
                <div class="dashboard-metric-label">Efectividad de IA (%)</div>
                <div class="dashboard-metric-value">@UsefulPercentDisplay</div>
                <div class="dashboard-metric-subtitle">Porcentaje de diagnósticos marcados como útiles.</div>
            </article>
        </section>

        <section class="dashboard-panel dashboard-table-card">
            <div class="d-flex flex-column flex-lg-row gap-3 justify-content-between align-items-lg-end mb-3">
                <div>
                    <h3 class="dashboard-chart-title">Transacciones</h3>
                    <p class="dashboard-chart-copy mb-0">Filtrá por los últimos 4 dígitos para investigar una tarjeta específica.</p>
                </div>

                <div>
                    <div class="dashboard-filter-row">
                        <input class="form-control dashboard-filter" placeholder="Filtrar por últimos 4 dígitos..." @bind="filterLast4" @bind:event="oninput" maxlength="4" pattern="\d*" inputmode="numeric" />
                        @if (isAdminUser)
                        {
                            <div class="form-check form-switch dashboard-inline-toggle mb-0" title="Ver todos los registros">
                                <InputCheckbox class="form-check-input" id="showAllRecordsDashboard" @bind-Value="showAllRecords" @bind-Value:after="ReloadDashboardAsync" />
                            </div>
                        }
                    </div>
                    <small class="dashboard-chart-copy">Escriba de 1 a 4 dígitos para filtrar en tiempo real (ej. 4, 43, 4532).</small>
                </div>
            </div>

            @if (gridTransactions == null)
            {
                <div class="dashboard-empty-state">Loading...</div>
            }
            else if (!FilteredTransactions.Any() && !string.IsNullOrWhiteSpace(filterLast4))
            {
                <div class="dashboard-empty-state">No se encontraron transacciones para la tarjeta ingresada.</div>
            }
            else if (gridTransactions.Count == 0)
            {
                <div class="dashboard-empty-state">No transactions found.</div>
            }
            else
            {
                <div class="table-responsive dashboard-table-wrap">
                    <table class="table table-borderless align-middle table-hover dashboard-table">
                        <thead>
                            <tr>
                                <th class="ps-3">Id</th>
                                <th>Amount</th>
                                <th>Currency</th>
                                <th>Tarjeta</th>
                                <th>Error</th>
                                <th>OccurredAt</th>
                                <th class="text-end pe-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in FilteredTransactions)
                            {
                                <tr class="align-middle">
                                    <td class="ps-3"><strong>@t.Id</strong></td>
                                    <td>@t.Amount</td>
                                    <td>@t.Currency</td>
                                    <td>
                                        <span class="badge rounded-pill dashboard-status-pill">@FormatCard(t.CardLast4)</span>
                                    </td>
                                    <td>
                                        <span class="badge rounded-pill dashboard-status-pill">@t.Status</span>
                                        @if (!string.IsNullOrWhiteSpace(t.ErrorMessage))
                                        {
                                            <div class="dashboard-chart-copy small mt-1">@t.ErrorMessage</div>
                                        }
                                    </td>
                                    <td>@t.OccurredAt?.ToString("g")</td>
                                    <td class="text-end pe-3">
                                        <button class="btn btn-ia" @onclick="() => AnalyzeAsync(t.Id)" disabled="@IsProcessing(t.Id)">
                                            @if (IsProcessing(t.Id))
                                            {
                                                <span class="spinner-border spinner-sm" role="status" aria-hidden="true"></span>
                                            }
                                            else
                                            {
                                                <span>Analizar con IA</span>
                                            }
                                        </button>
                                    </td>
                                </tr>

                                if (diagnostics.TryGetValue(t.Id, out var md) && !string.IsNullOrWhiteSpace(md))
                                {
                                    <tr>
                                        <td colspan="7">
                                            <div class="diagnostic-gem position-relative my-6 animate-fade-in max-w-7xl mx-auto">
                                                <button type="button" class="btn-close position-absolute" style="right:12px;top:12px;filter:invert(1);" aria-label="Close" @onclick="() => CloseDiagnostic(t.Id)"></button>
                                                <div class="diagnostic-content prose max-w-none leading-relaxed" style="font-family:Segoe UI, Roboto, Arial, sans-serif;">
                                                    @((MarkupString)RenderMarkdown(md))
                                                </div>

                                                @if (technicalDetails.TryGetValue(t.Id, out var tech) && !string.IsNullOrWhiteSpace(tech))
                                                {
                                                    <div class="mt-4">
                                                        <a href="#" class="text-slate-400" @onclick="(e) => ToggleTech(e, t.Id)">[+] Ver detalles técnicos</a>
                                                        @if (showTech.Contains(t.Id))
                                                        {
                                                            <pre class="mt-2" style="background:#0f1724;padding:10px;border-radius:6px;font-size:12px;color:#d1d5db;">@tech</pre>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</div>

    <!-- Toast container -->
    <div class="toasts-host p-3 position-fixed" style="right:24px;bottom:24px;z-index:9999;">
        @foreach(var toast in toasts)
        {
            <div class="mb-2" style="max-width:360px;">
                <div class="p-3" style="background:rgba(30,30,45,0.95);border:1px solid rgba(255,80,80,0.12);border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,0.5);color:#fff;">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="small text-muted">Notificación</div>
                            <div>@toast</div>
                        </div>
                        <button type="button" class="btn-close btn-close-white ms-2" aria-label="Close" @onclick="() => RemoveToast(toast)"></button>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (showChartsModal)
    {
    <div class="dashboard-modal-backdrop" @onclick="CloseChartsModal">
        <div class="dashboard-modal-shell" @onclick:stopPropagation="true">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                <div>
                    <h3 class="dashboard-chart-title mb-1">Gráficos del dashboard</h3>
                    <p class="dashboard-chart-copy mb-0">Motivos de falla y comparativa aprobadas vs. falladas.</p>
                </div>
                <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="CloseChartsModal"></button>
            </div>

            <section class="dashboard-chart-grid dashboard-chart-grid-modal">
                <article class="dashboard-panel dashboard-chart-card">
                    <div class="dashboard-chart-head">
                        <div>
                            <h3 class="dashboard-chart-title">Motivos de Falla Más Frecuentes</h3>
                            <p class="dashboard-chart-copy mb-0">Distribución de los errores más comunes en el panel actual.</p>
                        </div>
                    </div>

                    <div class="chart-host chart-host-modal">
                        <canvas id="failureReasonsChart"></canvas>
                    </div>
                </article>

                <article class="dashboard-panel dashboard-chart-card">
                    <div class="dashboard-chart-head">
                        <div>
                            <h3 class="dashboard-chart-title">Transacciones Aprobadas vs. Falladas</h3>
                            <p class="dashboard-chart-copy mb-0">Comparativa directa entre aprobaciones y rechazos.</p>
                        </div>
                    </div>

                    <div class="chart-host chart-host-modal">
                        <canvas id="transactionsSplitChart"></canvas>
                    </div>
                </article>
            </section>
        </div>
    </div>
}

@code {
    private List<Transaction>? allTransactions;
    private List<Transaction>? gridTransactions;
    private List<Transaction>? failedTransactions;
    private int FailedTransactionsCount;
    private int DiagnosticsCount;
    private int ApprovedTransactionsCount;
    private int FailedChartCount;
    private int ApprovedChartCount;
    private int UsefulPercent;
    private bool showAllRecords;
    private bool isAdminUser;
    private bool chartsDirty;
    private bool chartsRendering;
    private bool showChartsModal;
    private string? currentUserId;
    private int SuccessRatePercent;
    private List<(string Reason, int Count)> FailureReasons = new();
    private readonly Dictionary<int, bool> processing = new();
    private readonly Dictionary<int, string> diagnostics = new();
    private readonly Dictionary<int, string> technicalDetails = new();
    private readonly HashSet<int> showTech = new();
    private string filterLast4 = string.Empty;

    // SignalR real-time
    private HubConnection? hubConnection;
    private bool realtimePaused = false;
    private List<string> toasts = new();

    private static string FormatCard(string? last4)
    {
        if (string.IsNullOrWhiteSpace(last4))
        {
            return "-";
        }

        return $"•••• {last4}";
    }

    private IEnumerable<Transaction> FilteredTransactions
    {
        get
        {
            var list = failedTransactions ?? Enumerable.Empty<Transaction>();

            if (showAllRecords)
            {
                list = gridTransactions ?? Enumerable.Empty<Transaction>();
            }

            if (string.IsNullOrWhiteSpace(filterLast4))
            {
                return list;
            }

            if (filterLast4.Length > 4 || !filterLast4.All(char.IsDigit))
            {
                return list;
            }

            return list.Where(t => (t.CardLast4 ?? string.Empty).Contains(filterLast4));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadMetricsAsync();
        await LoadGridAsync();
        chartsDirty = true;

        // Initialize SignalR connection (guard: skip during SSR pre-render pass)
        if (hubConnection == null)
        try
        {
            hubConnection = new HubConnectionBuilder()
                .WithUrl(NavigationManager.ToAbsoluteUri("/hubs/transactions"))
                .WithAutomaticReconnect()
                .Build();

            hubConnection.On<Transaction>("ReceiveTransaction", async (tx) =>
            {
                if (realtimePaused) return;

                // Prepend to lists
                allTransactions ??= new List<Transaction>();
                gridTransactions ??= new List<Transaction>();
                failedTransactions ??= new List<Transaction>();

                allTransactions.Insert(0, tx);

                if (string.Equals(tx.Status, "Failed", StringComparison.OrdinalIgnoreCase))
                {
                    failedTransactions.Insert(0, tx);
                }

                if (!showAllRecords)
                {
                    gridTransactions = failedTransactions.ToList();
                }
                else
                {
                    gridTransactions.Insert(0, tx);
                }

                // Update metrics incrementally
                if (string.Equals(tx.Status, "Failed", StringComparison.OrdinalIgnoreCase))
                {
                    FailedTransactionsCount++;
                    FailedChartCount++;
                }
                else
                {
                    ApprovedTransactionsCount++;
                    ApprovedChartCount++;
                }

                // Total success rate recalculation (simple approximation)
                var total = (ApprovedTransactionsCount + FailedTransactionsCount);
                SuccessRatePercent = total == 0 ? 0 : (int)Math.Round(ApprovedTransactionsCount * 100.0 / total);

                // Toast for failures
                if (!string.IsNullOrWhiteSpace(tx.ErrorMessage))
                {
                    var toastMsg = $"Transacción {tx.Id} falló: {tx.ErrorMessage}";
                    toasts.Insert(0, toastMsg);
                    var captured = toastMsg;
                    _ = Task.Delay(8000).ContinueWith(_ => { _ = InvokeAsync(() => { toasts.Remove(captured); StateHasChanged(); }); });
                }

                await InvokeAsync(StateHasChanged);
            });

            await hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to start SignalR connection for dashboard.");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!showChartsModal || !chartsDirty || chartsRendering)
        {
            return;
        }

        chartsRendering = true;

        try
        {
            await RefreshChartsAsync();
            chartsDirty = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Dashboard charts failed to render.");
        }
        finally
        {
            chartsRendering = false;
        }
    }

    private void ToggleRealtime()
    {
        realtimePaused = !realtimePaused;
    }

    private void RemoveToast(string t)
    {
        toasts.Remove(t);
    }

    private string SuccessRateDisplay => SuccessRatePercent + "%";
    private string UsefulPercentDisplay => UsefulPercent < 0 ? "N/A" : UsefulPercent + "%";

    private async Task ReloadDashboardAsync()
    {
        await LoadMetricsAsync();
        await LoadGridAsync();
        chartsDirty = true;
    }

    private async Task OpenChartsModal()
    {
        showChartsModal = true;
        chartsDirty = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task CloseChartsModal()
    {
        showChartsModal = false;
        await JS.InvokeVoidAsync("dashboardCharts.destroy", "failureReasonsChart");
        await JS.InvokeVoidAsync("dashboardCharts.destroy", "transactionsSplitChart");
    }

    private async Task LoadMetricsAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        currentUserId = user?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        isAdminUser = user?.IsInRole("Auditor") == true || user?.IsInRole("Admin") == true;

        var diagnosticsData = await Db.Diagnostics.ToListAsync();
        var transactions = await Db.Transactions.ToListAsync();
        var feedback = await Db.DiagnosticFeedback.ToListAsync();
        var metrics = SmartOps.Web.Services.DashboardMetricsHelper.Build(transactions, feedback, diagnosticsData, showAllRecords, currentUserId);

        FailedTransactionsCount = metrics.FailedTransactionsCount;
        DiagnosticsCount = metrics.DiagnosticsCount;
        ApprovedTransactionsCount = metrics.ApprovedTransactionsCount;
        SuccessRatePercent = metrics.SuccessRatePercent;
        UsefulPercent = metrics.UsefulPercent;
        FailureReasons = metrics.FailureReasons.ToList();
        FailedChartCount = metrics.FailedChartCount;
        ApprovedChartCount = metrics.ApprovedChartCount;
    }

    private async Task LoadGridAsync()
    {
        allTransactions = await Db.Transactions.OrderByDescending(t => t.OccurredAt).ToListAsync();
        failedTransactions = allTransactions.Where(t => string.Equals(t.Status, "Failed", StringComparison.OrdinalIgnoreCase)).ToList();
        gridTransactions = showAllRecords ? allTransactions : failedTransactions;
    }

    private async Task RefreshChartsAsync()
    {
        var failureLabels = FailureReasons.Select(x => x.Reason).ToArray();
        var failureValues = FailureReasons.Select(x => x.Count).ToArray();

        await JS.InvokeVoidAsync("dashboardCharts.renderDoughnut", "failureReasonsChart", failureLabels, failureValues);
        await JS.InvokeVoidAsync(
            "dashboardCharts.renderBar",
            "transactionsSplitChart",
            new[] { "Totales" },
            new[] { ApprovedChartCount },
            new[] { FailedChartCount });
    }

    private bool IsProcessing(int id) => processing.TryGetValue(id, out var v) && v;

    private async Task AnalyzeAsync(int id)
    {
        processing[id] = true;
        diagnostics[id] = string.Empty;
        technicalDetails[id] = string.Empty;
        showTech.Remove(id);
        StateHasChanged();

        try
        {
            await Task.Delay(2500);

            var tx = await Db.Transactions.FindAsync(id);
            if (tx == null)
            {
                diagnostics[id] = "Transaction not found.";
            }
            else
            {
                try
                {
                    var state = await AuthStateProvider.GetAuthenticationStateAsync();
                    var user = state.User;
                    var createdByUserId = user?.Identity != null && user.Identity.IsAuthenticated
                        ? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                        : null;

                    var md = await Orchestrator.RunDiagnosticAsync(tx, createdByUserId);
                    ShowDiagnostic(id, md ?? string.Empty);
                    await LoadMetricsAsync();
                    chartsDirty = true;
                }
                catch (Exception exInner)
                {
                    diagnostics[id] = "⚠️ No logramos procesar el diagnóstico inteligente en este momento. Por favor, reintentá en unos instantes.";
                    technicalDetails[id] = exInner.ToString();
                }
            }
        }
        catch (Exception ex)
        {
            diagnostics[id] = "⚠️ No logramos procesar el diagnóstico inteligente en este momento. Por favor, reintentá en unos instantes.";
            technicalDetails[id] = ex.ToString();
        }
        finally
        {
            processing[id] = false;
            StateHasChanged();
        }
    }

    private static Guid CreateDeterministicGuidForInt(int id)
    {
        var ns = System.Text.Encoding.UTF8.GetBytes("SmartOps.Transaction.IntMapping");
        var idBytes = System.Text.Encoding.UTF8.GetBytes(id.ToString());
        using var md5 = System.Security.Cryptography.MD5.Create();
        var hash = md5.ComputeHash(ns.Concat(idBytes).ToArray());
        return new Guid(hash.Take(16).ToArray());
    }

    private string RenderMarkdown(string md)
    {
        if (string.IsNullOrWhiteSpace(md))
        {
            return string.Empty;
        }

        var encoded = System.Net.WebUtility.HtmlEncode(md);
        var lines = encoded.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
        var sb = new System.Text.StringBuilder();
        var inList = false;

        foreach (var raw in lines)
        {
            var line = raw.Trim();

            if (line.StartsWith("## "))
            {
                if (inList)
                {
                    sb.AppendLine("</ul>");
                    inList = false;
                }

                sb.AppendLine($"<h4>{line.Substring(3).Trim()}</h4>");
                continue;
            }

            if (line.StartsWith("- "))
            {
                if (!inList)
                {
                    sb.AppendLine("<ul style=\"margin-left:1rem;padding-left:1rem\">\n");
                    inList = true;
                }

                sb.AppendLine($"<li>{line.Substring(2).Trim()}</li>");
                continue;
            }

            if (inList)
            {
                sb.AppendLine("</ul>");
                inList = false;
            }

            sb.AppendLine($"<p>{line}</p>");
        }

        if (inList)
        {
            sb.AppendLine("</ul>");
        }

        return sb.ToString();
    }

    private void ShowDiagnostic(int id, string md)
    {
        var otherKeys = diagnostics.Keys.ToList();
        foreach (var k in otherKeys)
        {
            if (k != id)
            {
                diagnostics[k] = string.Empty;
            }
        }

        diagnostics[id] = md;
        technicalDetails[id] = string.Empty;
        showTech.Remove(id);
    }

    private void CloseDiagnostic(int id)
    {
        diagnostics[id] = string.Empty;
        technicalDetails.Remove(id);
        showTech.Remove(id);
    }

    private void ToggleTech(Microsoft.AspNetCore.Components.Web.MouseEventArgs e, int id)
    {
        if (showTech.Contains(id))
        {
            showTech.Remove(id);
        }
        else
        {
            showTech.Add(id);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
            await hubConnection.DisposeAsync();
    }
}
