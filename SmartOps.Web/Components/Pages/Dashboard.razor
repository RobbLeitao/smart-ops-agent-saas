@page "/"
@rendermode InteractiveServer
@using SmartOps.Core.Entities
@using Microsoft.EntityFrameworkCore
@inject SmartOps.Infrastructure.Data.AppDbContext Db
@inject SmartOps.Web.Services.DiagnosticOrchestratorService Orchestrator

<div class="bg-light min-vh-100 py-5">
    <div class="container-fluid">
        <div class="card rounded shadow-sm p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="mb-0">Centro de Operaciones de IA</h2>
                    <small class="text-muted">Monitoreo y diagnóstico de transacciones</small>
                </div>
                <div class="d-flex gap-3">
                    <div class="p-3 bg-white rounded shadow-sm text-center" style="min-width:140px;">
                        <div class="text-muted small">Transacciones Fallidas</div>
                        <div class="h5 mb-0">@((failedTransactions?.Count) ?? 0)</div>
                    </div>
                    <div class="p-3 bg-white rounded shadow-sm text-center" style="min-width:140px;">
                        <div class="text-muted small">Estado del Kernel</div>
                        <div class="h5 mb-0 text-success">Activo</div>
                    </div>
                </div>
            </div>

            @if (failedTransactions == null)
            {
                <p>Loading...</p>
            }
            else if (failedTransactions.Count == 0)
            {
                <p>No failed transactions found.</p>
            }
            else
            {
                    <div class="table-responsive">
                        <table class="table table-borderless align-middle">
                            <thead>
                                <tr class="text-muted small">
                                    <th class="ps-3">Id</th>
                                    <th>Amount</th>
                                    <th>Currency</th>
                                    <th>Error</th>
                                    <th>OccurredAt</th>
                                    <th class="text-end pe-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in failedTransactions)
                                {
                                    <tr class="align-middle">
                                        <td class="ps-3"><strong>@t.Id</strong></td>
                                        <td>@t.Amount</td>
                                        <td>@t.Currency</td>
                                        <td>
                                            <span class="badge rounded-pill" style="background-color:#F8D7DA;color:#842029;">Failed</span>
                                            <div class="text-muted small">@t.ErrorMessage</div>
                                        </td>
                                        <td>@t.OccurredAt?.ToString("g")</td>
                                        <td class="text-end pe-3">
                                            <button class="btn btn-ia" @onclick="() => AnalyzeAsync(t.Id)" disabled="@IsProcessing(t.Id)">
                                                @if (IsProcessing(t.Id))
                                                {
                                                    <span class="spinner-border spinner-sm" role="status" aria-hidden="true"></span>
                                                }
                                                else
                                                {
                                                    <span>Analizar con IA</span>
                                                }
                                            </button>
                                        </td>
                                    </tr>

                                    if (diagnostics.TryGetValue(t.Id, out var md) && !string.IsNullOrWhiteSpace(md))
                                    {
                                        <tr>
                                            <td colspan="6">
                                                <div class="p-3 bg-white diagnostic-panel position-relative" style="border-left:6px solid #0d6efd;">
                                                                                                    <button type="button" class="btn-close position-absolute" style="right:12px;top:12px;" aria-label="Close" @onclick="() => CloseDiagnostic(t.Id)"></button>
                                                                                                    <div style="font-family:Segoe UI, Roboto, Arial, sans-serif; color:#111;">
                                                                                                        @((MarkupString)RenderMarkdown(md))
                                                                                                    </div>

                                                                                                    @if (technicalDetails.TryGetValue(t.Id, out var tech) && !string.IsNullOrWhiteSpace(tech))
                                                                                                    {
                                                                                                        <div class="mt-2">
                                                                                                            <a href="#" @onclick="(e) => ToggleTech(e, t.Id)">[+] Ver detalles técnicos</a>
                                                                                                            @if (showTech.Contains(t.Id))
                                                                                                            {
                                                                                                                <pre class="mt-2" style="background:#f8f9fa;padding:10px;border-radius:6px;font-size:12px;">@tech</pre>
                                                                                                            }
                                                                                                        </div>
                                                                                                    }
                                                                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
            }
        </div>
    </div>
</div>

@code {
    private List<Transaction>? failedTransactions;
    private Dictionary<int, bool> processing = new();
    private Dictionary<int, string> diagnostics = new();
    private Dictionary<int, string> technicalDetails = new();
    private HashSet<int> showTech = new();

    protected override async Task OnInitializedAsync()
    {
                // Ensure sample failed transactions exist for UI/demo
                var existing = await Db.Transactions.Where(t => t.Status == "Failed").ToListAsync();
                var now = DateTime.UtcNow;
                const int target = 8; // ensure more volume
                if (existing == null) existing = new List<SmartOps.Core.Entities.Transaction>();
                var toAdd = new List<SmartOps.Core.Entities.Transaction>();
                var sampleErrors = new[] { "Card declined", "Expired card", "Insufficient funds", "Processing error", "Suspected fraud", "Invalid CVC" };
                int seedIndex = 0;
                while (existing.Count + toAdd.Count < target)
                {
                    var amt = 10m + (seedIndex * 5);
                    var currency = (seedIndex % 2 == 0) ? "USD" : "EUR";
                    var err = sampleErrors[seedIndex % sampleErrors.Length];
                    toAdd.Add(new SmartOps.Core.Entities.Transaction { CustomerId = 1, Amount = Math.Round(amt,2), Currency = currency, ErrorMessage = err, Status = "Failed", OccurredAt = now.AddMinutes(-(seedIndex+1)*15) });
                    seedIndex++;
                }

                if (toAdd.Count > 0)
                {
                    foreach (var s in toAdd) Db.Transactions.Add(s);
                    try
                    {
                        await Db.SaveChangesAsync();
                    }
                    catch (Exception ex)
                    {
                        // Surface seeding errors to the console for diagnostics during development
                        Console.Error.WriteLine($"Failed to seed transactions: {ex}");
                        throw;
                    }
                }

        failedTransactions = await Db.Transactions.Where(t => t.Status == "Failed").OrderByDescending(t => t.OccurredAt).ToListAsync();
    }

    private bool IsProcessing(int id) => processing.TryGetValue(id, out var v) && v;

    private async Task AnalyzeAsync(int id)
    {
        processing[id] = true;
        // Clear previous outputs for this transaction so we always re-run fresh
        diagnostics[id] = string.Empty;
        technicalDetails[id] = string.Empty;
        showTech.Remove(id);
        StateHasChanged();

        try
        {
            StateHasChanged();

            // Simulate realistic delay so button spinner is visible in UI tests
            await Task.Delay(2500);

            // Resolve the transaction and pass the full entity to the orchestrator.
            var tx = await Db.Transactions.FindAsync(id);
            if (tx == null)
            {
                diagnostics[id] = "Transaction not found.";
            }
            else
            {
                try
                {
                    var md = await Orchestrator.RunDiagnosticAsync(tx);
                                        ShowDiagnostic(id, md ?? "");
                }
                catch (Exception exInner)
                {
                    // Friendly business-facing message
                    diagnostics[id] = "⚠️ No logramos procesar el diagnóstico inteligente en este momento. Por favor, reintentá en unos instantes.";
                    // Store the technical details for optional inspection
                    technicalDetails[id] = exInner.ToString();
                }
            }
        }
        catch (Exception ex)
        {
            diagnostics[id] = "⚠️ No logramos procesar el diagnóstico inteligente en este momento. Por favor, reintentá en unos instantes.";
            technicalDetails[id] = ex.ToString();
        }
        finally
        {
            processing[id] = false;
            StateHasChanged();
        }
    }

    private static Guid CreateDeterministicGuidForInt(int id)
    {
        // Create a stable GUID from the int using MD5 hash of a namespace + id string
        var ns = System.Text.Encoding.UTF8.GetBytes("SmartOps.Transaction.IntMapping");
        var idBytes = System.Text.Encoding.UTF8.GetBytes(id.ToString());
        using var md5 = System.Security.Cryptography.MD5.Create();
        var hash = md5.ComputeHash(ns.Concat(idBytes).ToArray());
        return new Guid(hash.Take(16).ToArray());
    }

    private string RenderMarkdown(string md)
    {
        // Very simple markdown rendering: headings and line breaks
        var html = System.Net.WebUtility.HtmlEncode(md);
        html = System.Text.RegularExpressions.Regex.Replace(html, "^## (.+)$", "<h4>$1</h4>", System.Text.RegularExpressions.RegexOptions.Multiline);
        html = html.Replace("\n\n", "<br/><br/>");
        html = html.Replace("- ", "<li>").Replace("\n", "</li>\n");
        return html;
    }

    private void ShowDiagnostic(int id, string md)
    {
            // Clear diagnostics for other transactions so only one panel is open at a time
            var otherKeys = diagnostics.Keys.ToList();
            foreach (var k in otherKeys)
            {
                if (k != id) diagnostics[k] = string.Empty;
            }

            diagnostics[id] = md;
            technicalDetails[id] = string.Empty;
            showTech.Remove(id);
        }

        private void CloseDiagnostic(int id)
        {
            diagnostics[id] = string.Empty;
            technicalDetails.Remove(id);
            showTech.Remove(id);
        }

        private void ToggleTech(Microsoft.AspNetCore.Components.Web.MouseEventArgs e, int id)
        {
            if (showTech.Contains(id)) showTech.Remove(id); else showTech.Add(id);
        }
}
