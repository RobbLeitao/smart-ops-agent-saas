@page "/login"
@layout SmartOps.Web.Components.LoginLayout
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Identity
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<style>
    .login-panel { max-width:420px;margin:80px auto;padding:28px;border-radius:12px;background:#1e2330;border:1px solid rgba(255,255,255,0.04); }
    .login-panel h3 { color:#e6eef8; }
    .login-label { color:#cbd5e1; }

    /* Transición Login → Dashboard (docs/redesign/README.md): la tarjeta se va con fade out
       (opacidad 1→0 y sube 8px, 200 ms, ease-in) y recién después se navega. */
    .login-panel { transition: opacity 200ms ease-in, transform 200ms ease-in; }
    .login-panel.is-leaving { opacity: 0; transform: translateY(-8px); }

    @@media (prefers-reduced-motion: reduce) {
        .login-panel { transition: opacity 120ms ease-in; }
        .login-panel.is-leaving { transform: none; }
    }
</style>

<div class="login-panel @(isLeaving ? "is-leaving" : "")">
    <h3>Iniciar Sesión</h3>
    <div class="mb-3">
        <label class="login-label">Email</label>
        <input class="form-control" @bind="Email" disabled="@isLoading" />
    </div>
    <div class="mb-3">
        <label class="login-label">Contraseña</label>
        <input class="form-control" type="password" @bind="Password" disabled="@isLoading" />
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-primary" @onclick="HandleLogin" disabled="@isLoading">@(isLoading ? "Ingresando…" : "Entrar")</button>

    </div>
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="mt-2 text-danger">@ErrorMessage</div>
    }
</div>


@code {
    private string Email { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;
    private string? ErrorMessage;
    private bool isLoading;
    private bool isLeaving;

    // Debe coincidir con la transición CSS de .login-panel.is-leaving.
    private static readonly TimeSpan LeaveDuration = TimeSpan.FromMilliseconds(200);

    private async Task HandleLogin()
    {
        if (isLoading) return;

        ErrorMessage = null;

        // Validation: require both fields
        if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Password))
        {
            ErrorMessage = "Los campos están vacíos.";
            return;
        }

        isLoading = true;

        // Call the account HTTP endpoint which will set the auth cookie outside the Blazor circuit
        try
        {
            var payload = new { Email = Email, Password = Password };
            var uri = Navigation.ToAbsoluteUri("/account/login").ToString();
            // Serialize in C# and send raw JSON string to JS to avoid double-serialization
            var jsonPayload = System.Text.Json.JsonSerializer.Serialize(payload);
            var jsResult = await JS.InvokeAsync<string>("fetchLogin", uri, jsonPayload);
            var doc = System.Text.Json.JsonDocument.Parse(jsResult);
            var status = doc.RootElement.GetProperty("status").GetInt32();
            var text = doc.RootElement.GetProperty("text").GetString() ?? string.Empty;
            if (status >= 200 && status <= 299)
            {
                // Fade out de la tarjeta y recién después la navegación completa (forceLoad: la cookie
                // de auth la necesita). El Dashboard entra con su propio fade in y skeleton.
                isLeaving = true;
                StateHasChanged();
                await Task.Delay(LeaveDuration);
                Navigation.NavigateTo("/", true);
                return;
            }
            else if (status == 401)
            {
                ErrorMessage = "Usuario o constraseña incorrectos";
            }
            else if (status == 400)
            {
                try
                {
                    var bodyDoc = System.Text.Json.JsonDocument.Parse(text);
                    if (bodyDoc.RootElement.TryGetProperty("error", out var e)) ErrorMessage = e.GetString() ?? "Los campos están vacíos.";
                    else ErrorMessage = "Los campos están vacíos.";
                }
                catch
                {
                    ErrorMessage = "Los campos están vacíos.";
                }
            }
            else
            {
                ErrorMessage = "Ocurrió un error al iniciar sesión. Intentá nuevamente.";
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Login HTTP error: {ex}");
            ErrorMessage = "Ocurrió un error al iniciar sesión. Intentá nuevamente.";
        }

        // Solo se llega acá si el login no fue exitoso: el botón vuelve a «Entrar».
        isLoading = false;
    }
}
