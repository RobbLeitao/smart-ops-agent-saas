@page "/login"
@layout SmartOps.Web.Components.LoginLayout
@rendermode InteractiveServer
@using SmartOps.Web.Services
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Iniciar sesión · SmartOps</PageTitle>

@* Login (docs/redesign/06-login.html). *@
<main class="login @(isLeaving ? "is-leaving" : null)">
    <img src="/images/logo.png" alt="SmartOps" class="login-logo" />

    <form class="login-card" novalidate @onsubmit="HandleLogin">
        <div>
            <h1 class="login-title">Iniciá sesión</h1>
            <p class="login-subtitle">Consola de operaciones y diagnóstico con IA.</p>
        </div>

        <div class="ds-field">
            <label class="ds-label" for="login-email">Email</label>
            <input id="login-email" class="ds-input" type="email" autocomplete="username" spellcheck="false"
                   aria-invalid="@(EmailError is not null ? "true" : "false")"
                   aria-describedby="@(EmailError is not null ? "login-email-error" : null)"
                   @bind="Email" disabled="@isLoading" />
            @if (EmailError is not null)
            {
                <span id="login-email-error" class="ds-error">@EmailError</span>
            }
        </div>

        <div class="ds-field">
            <label class="ds-label" for="login-password">Contraseña</label>
            <span class="ds-reveal">
                <input id="login-password" class="ds-input" type="@(showPassword ? "text" : "password")" autocomplete="current-password"
                       aria-invalid="@(PasswordError is not null ? "true" : "false")"
                       aria-describedby="@(PasswordError is not null ? "login-password-error" : null)"
                       @bind="Password" disabled="@isLoading" />
                <button type="button" class="ds-reveal-btn" aria-controls="login-password" aria-pressed="@(showPassword ? "true" : "false")"
                        disabled="@isLoading" @onclick="() => showPassword = !showPassword">@(showPassword ? "Ocultar" : "Mostrar")</button>
            </span>
            @if (PasswordError is not null)
            {
                <span id="login-password-error" class="ds-error">@PasswordError</span>
            }
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="ds-alert ds-alert-danger" role="alert">
                <svg class="ds-alert-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v6M12 16.5v.5"></path></svg>
                <span>@ErrorMessage</span>
            </div>
        }

        <button type="submit" class="btn-ds btn-ds-primary login-submit" disabled="@isLoading">@(isLoading ? "Ingresando…" : "Ingresar")</button>
    </form>

    <p class="login-footnote">¿No tenés acceso? Pedíselo a un Auditor de tu equipo.</p>
</main>

@code {
    private string Email { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;
    private string? ErrorMessage;
    private bool showValidation;
    private bool showPassword;
    private bool isLoading;
    private bool isLeaving;

    // Debe coincidir con la transición CSS de .login.is-leaving.
    private static readonly TimeSpan LeaveDuration = TimeSpan.FromMilliseconds(200);

    private string? EmailError => showValidation && string.IsNullOrWhiteSpace(Email) ? LoginErrorMapper.EmailRequired : null;
    private string? PasswordError => showValidation && string.IsNullOrWhiteSpace(Password) ? LoginErrorMapper.PasswordRequired : null;

    private async Task HandleLogin()
    {
        if (isLoading) return;

        ErrorMessage = null;
        showValidation = true;

        // Campos vacíos: validación en el formulario, sin llamar al servidor.
        if (EmailError is not null || PasswordError is not null)
        {
            return;
        }

        isLoading = true;

        int? status = null;
        try
        {
            // The account endpoint sets the auth cookie outside the Blazor circuit.
            var uri = Navigation.ToAbsoluteUri("/account/login").ToString();
            var jsonPayload = System.Text.Json.JsonSerializer.Serialize(new { Email = Email.Trim(), Password });
            var jsResult = await JS.InvokeAsync<string>("fetchLogin", uri, jsonPayload);
            using var doc = System.Text.Json.JsonDocument.Parse(jsResult);
            status = doc.RootElement.GetProperty("status").GetInt32();
        }
        catch (Exception ex)
        {
            // Network / JS interop failure: no HTTP status. Never log the payload.
            Console.Error.WriteLine($"Login request failed: {ex.GetType().Name}");
        }

        ErrorMessage = LoginErrorMapper.Map(status);
        if (ErrorMessage is null)
        {
            // Fade out de la tarjeta y recién después la navegación completa (forceLoad: la cookie
            // de auth la necesita). El Dashboard entra con su propio fade in y skeleton.
            isLeaving = true;
            StateHasChanged();
            await Task.Delay(LeaveDuration);
            Navigation.NavigateTo("/", true);
            return;
        }

        // Solo se llega acá si el login no fue exitoso: el botón vuelve a «Ingresar».
        isLoading = false;
    }
}
